cabal-version: 3.0
name: circuits-ad
version: 0.1.0.0
license: BSD-3-Clause
author: Tony Day
maintainer: tonyday567@gmail.com
category: math
synopsis: Oracle tests: circuits reverse-mode AD against ad-delcont
description:
  Reverse-mode automatic differentiation for the circuits ecosystem.
  Provides an oracle comparing circuit derivatives against ad-delcont,
  plus eliminators, pullbacks, and star-semiring structure for AD.
build-type: Simple

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-ad

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wno-unused-top-binds
    -Wno-unused-matches
    -Wno-orphans

library
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: src
  exposed-modules:
    Circuit.AD
    Circuit.AD.Eliminate
    Circuit.AD.Matrix
    Circuit.AD.Melt
    Circuit.AD.Metric
    Circuit.AD.Oracle
    Circuit.AD.Param
    Circuit.AD.Pullback
    Circuit.AD.Star
  build-depends:
    base >=4.18 && <5,
    circuits >=0.3 && <0.4,
    numhask-diff >=0.1 && <0.2,
    numhask >=0.14 && <0.15,
    ad-delcont >=0.5 && <0.6,
    transformers >=0.5 && <0.7,

test-suite verify
  import: ghc-options-stanza
  default-language: GHC2024
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Verify.hs
  other-modules:
    MatrixStar
    MetricAdjoint
    StarEliminate
    Tags
  build-depends:
    base >=4.18 && <5,
    circuits-ad,
    circuits,
    numhask-diff,
    numhask,

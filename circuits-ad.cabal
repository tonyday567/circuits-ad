cabal-version: 3.0
name: circuits-ad
version: 0.1.0.0
license: BSD-3-Clause
author: Tony Day
maintainer: tonyday567@gmail.com
synopsis: Oracle tests: circuits reverse-mode AD against ad-delcont
build-type: Simple

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wno-unused-top-binds
    -Wno-unused-matches
    -Wno-orphans

library
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: src
  exposed-modules:
    Circuit.AD
    Circuit.AD.Eliminate
    Circuit.AD.Melt
    Circuit.AD.Oracle
    NumHask.Diff
    Circuit.AD.Pullback
    Circuit.AD.Star
  build-depends:
    base >=4.18 && <5,
    circuits,
    hasknum,
    numhask,
    ad-delcont,
    transformers >=0.5,

test-suite verify
  import: ghc-options-stanza
  default-language: GHC2024
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Verify.hs
  other-modules:
    StarEliminate
    Tags
  build-depends:
    base >=4.18 && <5,
    circuits-ad,
    circuits,
    hasknum,
    numhask,

cabal-version: 3.0
name: circuits-ad
version: 0.1.0.0
license: BSD-3-Clause
author: Tony Day
maintainer: tonyday567@gmail.com
category: math
synopsis: Reverse-mode automatic differentiation for circuits
description:
  Reverse-mode automatic differentiation for the circuits ecosystem.
  Provides eliminators, pullbacks, and star-semiring structure for AD.
  Oracle comparisons against ad-delcont live in the separate
  @circuits-ad-observe@ package.
build-type: Simple

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-ad

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wno-unused-top-binds
    -Wno-unused-matches
    -Wno-orphans

library
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: src
  exposed-modules:
    Circuit.AD
    Circuit.AD.Chart
    Circuit.AD.Curvature
    Circuit.AD.DubinsChase
    Circuit.AD.Eliminate
    Circuit.AD.Melt
    Circuit.AD.Metric
    Circuit.AD.Param
    Circuit.AD.Pullback
    Circuit.AD.Star
  build-depends:
    base >=4.18 && <5,
    circuits >=0.3 && <0.4,
    harpie-numhask >=0.2 && <0.3,
    numhask-diff >=0.1 && <0.2,
    numhask >=0.14 && <0.15,
    transformers >=0.5 && <0.7,

executable circuits-ad-axioma
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: app
  main-is: axioma.hs
  other-modules:
    Curvature
    DubinsChase
    GeodesicFlow
    Kepler
    MatrixStar
    MetricAdjoint
    StarEliminate
    Tags
  build-depends:
    base >=4.18 && <5,
    circuits-ad,
    circuits,
    harpie-numhask,
    numhask-diff,
    numhask,
